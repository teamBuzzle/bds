	"repository": {
		"type": "git",
		"url": "https://github.com/STREACT/bds.git"
	},
	"scripts": {
		"build": "tsc -b && vite build && yarn storybook:build",
		"dev": "storybook dev -p 3000 --no-open",
		"storybook:build": "storybook build",
		"storybook:upgrade": "yarn dlx storybook@latest upgrade",
		"lint": "eslint .",
		"lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
		"prettier": "prettier --write .",
		"type-check": "tsc --noEmit",
		"type-check:watch": "tsc --noEmit --watch",
		"postinstall": "husky",
		"preinstall": "npx only-allow yarn",
		"sdks": "yarn dlx @yarnpkg/sdks vscode"
	},
	"peerDependencies": {
		"@emotion/react": "^11.13.5",
		"@emotion/styled": "^11.13.5",
		"@mui/material": "^6.1.9",
		"motion": "^11.12.0",
		"react": "^17.0.0 || ^18.0.0",
		"react-dom": "^17.0.0 || ^18.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.6.1",
		"@commitlint/config-conventional": "^19.6.0",
		"@emotion/react": "^11.13.5",
		"@emotion/styled": "^11.13.5",
		"@eslint/js": "^9.10.0",
		"@mui/material": "^6.1.9",
		"@storybook/addon-a11y": "^8.4.7",
		"@storybook/addon-essentials": "^8.4.7",
		"@storybook/addon-interactions": "^8.4.7",
		"@storybook/addon-links": "^8.4.7",
		"@storybook/addon-viewport": "^8.4.7",
		"@storybook/blocks": "^8.4.7",
		"@storybook/manager-api": "^8.4.7",
		"@storybook/react": "^8.4.7",
		"@storybook/react-vite": "^8.4.7",
		"@storybook/test": "^8.4.7",
		"@storybook/theming": "^8.4.7",
		"@types/esprima": "^4.0.6",
		"@types/react": "^18.3.18",
		"@types/react-dom": "^18.3.5",
		"@vitejs/plugin-react": "^4.3.4",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-prettier": "^5.2.1",
		"eslint-plugin-react-hooks": "^5.1.0",
		"eslint-plugin-react-refresh": "^0.4.16",
		"eslint-plugin-storybook": "^0.11.1",
		"esprima": "^4.0.1",
		"globals": "^15.14.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.2.11",
		"motion": "^11.12.0",
		"prettier": "^3.4.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"storybook": "^8.4.7",
		"supports-color": "^9.4.0",
		"tsconfig-paths": "^4.2.0",
		"typescript": "5.5.4",
		"typescript-eslint": "^8.18.1",
		"vite": "^6.0.5",
		"vite-plugin-dts": "^4.4.0",
		"vite-tsconfig-paths": "^5.1.4"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"bash -c 'yarn prettier'",
			"bash -c 'yarn lint'",
			"bash -c 'yarn type-check'"
		],
		"*.{json,md}": [
			"bash -c 'yarn prettier'"
		]
	},
	"packageManager": "yarn@4.5.3",
	"engines": {
		"node": "20.13.1"
	},
	"volta": {
		"node": "20.13.1",
