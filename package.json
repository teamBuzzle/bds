{
	"name": "@buzzle/bds",
	"version": "0.1.22",
	"type": "module",
	"license": "MIT",
	"description": "Buzzle Design System (based on MUI)",
	"author": {
		"name": "Buzzle",
		"email": "coolman555@me.com"
	},
	"homepage": "https://github.com/teamBuzzle/bds",
	"repository": {
		"type": "git",
		"url": "https://github.com/teamBuzzle/bds.git"
	},
	"main": "dist/main.js",
	"module": "dist/main.js",
	"types": "dist/main.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/main.d.ts",
			"require": "./dist/main.js",
			"default": "./dist/main.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.node.json && VITE_CJS_TRACE=true vite build && yarn build:storybook",
		"build:storybook": "NODE_ENV=production VITE_DISABLE_ESLINT=true NODE_OPTIONS=--no-warnings storybook build --quiet",
		"dev": "storybook dev -p 3000 --no-open",
		"storybook:build": "NODE_ENV=production VITE_DISABLE_ESLINT=true NODE_OPTIONS=--no-warnings storybook build --quiet",
		"storybook:upgrade": "yarn dlx storybook@latest upgrade",
		"lint": "eslint .",
		"lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
		"prettier": "prettier --write .",
		"type-check": "tsc --noEmit",
		"type-check:watch": "tsc --noEmit --watch",
		"prepublishOnly": "yarn lint && yarn type-check && yarn build",
		"release": "standard-version && git push --follow-tags && npm publish",
		"release:major": "standard-version -- --release-as minor",
		"prepare": "node .husky/install.mjs",
		"preinstall": "npx only-allow yarn",
		"sdks": "yarn dlx @yarnpkg/sdks vscode"
	},
	"peerDependencies": {
		"@emotion/react": "^11.13.5",
		"@emotion/styled": "^11.13.5",
		"@mui/material": "^7.0.1",
		"@tanstack/react-table": "^8.21.2",
		"d3": "^7.9.0",
		"motion": "^11.12.0",
		"react": "^17.0.0 || ^18.0.0 || ^19.0.0",
		"react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.7.1",
		"@commitlint/config-conventional": "^19.7.1",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.0",
		"@eslint/compat": "^1.2.6",
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.20.0",
		"@mui/material": "^7.0.1",
		"@storybook/addon-a11y": "^8.6.12",
		"@storybook/addon-essentials": "^8.6.12",
		"@storybook/addon-interactions": "^8.6.12",
		"@storybook/addon-links": "^8.6.12",
		"@storybook/blocks": "^8.6.12",
		"@storybook/builder-vite": "^8.6.12",
		"@storybook/manager-api": "^8.6.12",
		"@storybook/react": "^8.6.12",
		"@storybook/react-vite": "^8.6.12",
		"@storybook/test": "^8.6.12",
		"@storybook/theming": "^8.6.12",
		"@tanstack/react-table": "^8.21.2",
		"@types/d3": "^7",
		"@types/eslint-plugin-jsx-a11y": "^6.10.0",
		"@types/esprima": "^4.0.6",
		"@types/react": "^19.0.8",
		"@types/react-dom": "^19.0.3",
		"@typescript-eslint/eslint-plugin": "^8.23.0",
		"@typescript-eslint/parser": "^8.23.0",
		"@vitejs/plugin-react": "^4.3.4",
		"d3": "^7.9.0",
		"eslint": "^9.20.0",
		"eslint-config-airbnb": "^19.0.4",
		"eslint-config-airbnb-typescript": "^18.0.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prettier": "^5.2.3",
		"eslint-plugin-react": "^7.37.4",
		"eslint-plugin-react-hooks": "^5.1.0",
		"eslint-plugin-react-refresh": "^0.4.19",
		"eslint-plugin-storybook": "^0.12.0",
		"esprima": "^4.0.1",
		"globals": "^15.14.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.4.3",
		"motion": "^12.4.1",
		"prettier": "^3.5.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"standard-version": "^9.5.0",
		"storybook": "^8.6.12",
		"supports-color": "^10.0.0",
		"tsconfig-paths": "^4.2.0",
		"typescript": "5.5.4",
		"typescript-eslint": "^8.23.0",
		"vite": "^6.0.9",
		"vite-plugin-dts": "^4.5.0",
		"vite-tsconfig-paths": "^5.1.4"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"bash -c 'yarn prettier'",
			"bash -c 'yarn lint'",
			"bash -c 'yarn type-check'"
		],
		"*.{json,md}": [
			"bash -c 'yarn prettier'"
		]
	},
	"packageManager": "yarn@4.8.1",
	"engines": {
		"node": "22.14.0"
	},
	"volta": {
		"node": "22.14.0",
		"yarn": "4.8.1"
	},
	"publishConfig": {
		"access": "public"
	}
}
