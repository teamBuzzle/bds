{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023", "DOM"],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "Node",
		"isolatedModules": false,
		"moduleDetection": "force",
		"noEmit": false,
		"emitDeclarationOnly": true,
		"strict": true,
		"jsx": "react-jsx",
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noFallthroughCasesInSwitch": true,
		"declaration": true,
		"declarationDir": "./dist",
		"outDir": "./dist",
		"baseUrl": "./",
		"paths": {
			"@/*": ["./lib/*"]
		},
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true
	},
	"include": ["lib/**/*.ts", "lib/**/*.tsx"],
	"exclude": ["node_modules", "**/*.stories.tsx", "**/*.test.tsx", "**/*.spec.ts", ".storybook", "storybook-static"]
}
