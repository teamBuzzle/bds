{
  "search.exclude": {
    "**/.yarn": true,
    "**/.pnp.*": true
  },
  "eslint.nodePath": ".yarn/sdks",
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "cSpell.words": [
    "autodocs",
    "Buzzle",
    "commitlint",
    "Gmarket",
    "njsproj",
    "Noto",
    "ntvs",
    "Parens",
    "peaceiris",
    "preinstall",
    "Pretendard",
    "srcset",
    "thumbsup",
    "tseslint",
    "WCAG",
    "yarnpkg"
  ],
  "prettier.prettierPath": ".yarn/sdks/prettier/index.cjs",
  "npm.packageManager": "yarn"
}
